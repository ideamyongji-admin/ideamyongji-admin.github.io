rules_version = '2';

// IDEA 라운지 예약 시스템 보안 규칙.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 게시하세요.
//
// 로그인은 Google 계정으로 하며(학교 이메일 도메인을 강제할 수 없음), 대신 로그인 직후
// 학번을 직접 입력받아 users/{uid} 문서에 저장합니다. 이 학번이 마이크로디그리 명단
// (microdegreeRoster, 문서 ID = 학번)에 있는지로 우선권을 판단합니다.
// 주의: 학번은 자기 입력(self-report)이라 완벽한 신원 증명은 아닙니다. 내부용 예약
// 시스템 수준의 신뢰 모델로 채택한 절충안입니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자로 지정된 Google 계정만 명단 관리/예약 관리 화면에 접근할 수 있습니다.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email in ['mthan@mju.ac.kr'];
    }

    function myStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId;
    }

    function isPriorityMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/microdegreeRoster/$(myStudentId()));
    }

    // 하루 예약 한도(2시간=슬롯 2개) 확인용: 아직 그날 예약이 없으면 0시간으로 간주
    function dailyUsageId(date) {
      return request.auth.uid + '_' + date;
    }
    function currentDailyHours(date) {
      return exists(/databases/$(database)/documents/dailyUsage/$(dailyUsageId(date)))
        ? get(/databases/$(database)/documents/dailyUsage/$(dailyUsageId(date))).data.hours
        : 0;
    }

    // 테이블 정보: 누구나 읽기 가능(로그인 전에도 현황 확인 가능), 쓰기는 콘솔에서만
    match /tables/{tableId} {
      allow read: if true;
      allow write: if false;
    }

    // 사용자 프로필(학번·이름): 본인만 생성·조회 가능. 잘못 입력한 경우 수정은
    // 악용(학번 바꿔치기) 방지를 위해 막아두고, 관리자가 콘솔에서 직접 고쳐줍니다.
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if false;
    }

    // 마이크로디그리 명단(문서 ID = 학번): 누구나 본인 학번 여부는 단건 조회 가능,
    // 전체 목록 조회·등록·삭제는 관리자 전용
    match /microdegreeRoster/{studentId} {
      allow get: if isSignedIn();
      allow list, write: if isAdmin();
    }

    // 예약: 문서 ID를 "{tableId}_{date}_{startTime}" 형식으로 고정합니다.
    // 같은 슬롯에 대한 동시 예약 요청이 와도 Firestore가 문서 생성을 하나만 허용하므로
    // 별도의 트랜잭션 없이 중복 예약이 원천 차단됩니다.
    match /reservations/{reservationId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tableId in ['table-1', 'table-2', 'table-3', 'table-4']
        // 1~3번 테이블은 마이크로디그리 학생 전용, 4번 테이블은 전체 학생 이용 가능
        && (request.resource.data.tableId == 'table-4' || isPriorityMember())
        && reservationId == request.resource.data.tableId + '_' + request.resource.data.date + '_' + request.resource.data.startTime
        // 1인당 하루 최대 2시간(슬롯 2개)까지만 예약 가능. dailyUsage 문서는
        // 같은 트랜잭션 안에서 함께 +1 되어야 하며, 그 값 자체는 아래 dailyUsage 규칙이 검증합니다.
        && currentDailyHours(request.resource.data.date) < 2;

      // 본인 예약이거나 관리자면 취소(삭제) 가능, 수정은 허용하지 않음(취소 후 재예약)
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if false;
    }

    // 하루 예약 시간 누적치(문서 ID = "{uid}_{date}"). 예약 생성/취소 시 클라이언트가
    // 트랜잭션으로 reservations와 함께 +1/-1 합니다. 한 번에 1씩만, 최대 2까지만 증가 허용.
    match /dailyUsage/{usageId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && usageId == dailyUsageId(request.resource.data.date)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.hours == 1;

      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin())
        && (
          (request.resource.data.hours == resource.data.hours + 1 && request.resource.data.hours <= 2) ||
          (request.resource.data.hours == resource.data.hours - 1 && request.resource.data.hours >= 0)
        );

      allow delete: if false;
    }
  }
}
