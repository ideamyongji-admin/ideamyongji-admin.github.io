rules_version = '2';

// IDEA 라운지 예약 시스템 보안 규칙.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣고 게시하세요.
//
// 로그인은 Google 계정으로 하며(학교 이메일 도메인을 강제할 수 없음), 대신 로그인 직후
// 학번을 직접 입력받아 users/{uid} 문서에 저장합니다. 이 학번이 마이크로디그리 명단
// (microdegreeRoster, 문서 ID = 학번)에 있는지로 우선권을 판단합니다.
// 주의: 학번은 자기 입력(self-report)이라 완벽한 신원 증명은 아닙니다. 내부용 예약
// 시스템 수준의 신뢰 모델로 채택한 절충안입니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.studentId;
    }

    function isPriorityMember() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/microdegreeRoster/$(myStudentId()));
    }

    // 테이블 정보: 누구나 읽기 가능(로그인 전에도 현황 확인 가능), 쓰기는 콘솔에서만
    match /tables/{tableId} {
      allow read: if true;
      allow write: if false;
    }

    // 사용자 프로필(학번·이름): 본인만 생성·조회 가능. 잘못 입력한 경우 수정은
    // 악용(학번 바꿔치기) 방지를 위해 막아두고, 관리자가 콘솔에서 직접 고쳐줍니다.
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update, delete: if false;
    }

    // 마이크로디그리 명단(문서 ID = 학번): 특정 학번이 명단에 있는지 단건 조회만 허용,
    // 전체 목록 조회·쓰기는 관리자(콘솔) 전용
    match /microdegreeRoster/{studentId} {
      allow get: if isSignedIn();
      allow list, write: if false;
    }

    // 예약: 문서 ID를 "{tableId}_{date}_{startTime}" 형식으로 고정합니다.
    // 같은 슬롯에 대한 동시 예약 요청이 와도 Firestore가 문서 생성을 하나만 허용하므로
    // 별도의 트랜잭션 없이 중복 예약이 원천 차단됩니다.
    match /reservations/{reservationId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tableId in ['table-1', 'table-2', 'table-3', 'table-4']
        // 1~3번 테이블은 마이크로디그리 학생 전용, 4번 테이블은 전체 학생 이용 가능
        && (request.resource.data.tableId == 'table-4' || isPriorityMember())
        && reservationId == request.resource.data.tableId + '_' + request.resource.data.date + '_' + request.resource.data.startTime;

      // 본인 예약만 취소(삭제) 가능, 수정은 허용하지 않음(취소 후 재예약)
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
